# Copy to .env (never commit .env). Everything is optional for local dev:
# with no Supabase keys the server keeps data in memory.

PORT=3001

# Comma-separated list of allowed browser origins (your deployed client URL, etc.).
# localhost and LAN addresses are always allowed outside production.
CLIENT_URL=http://localhost:5173

# Supabase: Project Settings > API. Use the service_role key. It stays on the server ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
