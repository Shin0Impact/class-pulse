# Copy to .env (never commit .env). Everything is optional for local dev:
# with no Supabase keys the server keeps data in memory.

PORT=3001

# Comma-separated list of allowed browser origins (your deployed client URL, etc.).
# localhost and LAN addresses are always allowed outside production.
CLIENT_URL=http://localhost:5173

# Supabase: Project Settings > API. Use the service_role key. It stays on the server ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AI (question generation + class-confusion summaries). Optional: without keys, AI buttons are hidden.
# Gemini is tried first (free key: https://aistudio.google.com > Get API key), Claude is the backup.
# Check your setup with: npm run ai:check
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite   # tried in this order
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001
